n = int(input("Enter a number: "))

# Palindrome check
if str(n) == str(n)[::-1]:
    print("Palindrome number")
else:
    print("Not a palindrome number")

# Armstrong number check
digits = str(n)
power = len(digits)
total = sum(int(digit) ** power for digit in digits)

if total == n:
    print("Armstrong number")
else:
    print("Not an Armstrong number")
