enum PaymentMethod {
    case cash
    case card(number: String)
    case upi(id: String)
}

func processPayment(_ method: PaymentMethod) {
    switch method {
    case .cash:
        print("Payment made using cash.")

    case .card(let number):
        print("Payment made using card number: \(number)")

    case .upi(let id):
        print("Payment made using UPI ID: \(id)")
    }
}
processPayment(.cash)
processPayment(.card(number: "1234-5678"))
processPayment(.upi(id: "user@upi"))
