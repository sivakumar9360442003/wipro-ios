struct StudentStruct {
    var name: String
}

class StudentClass {
    var name: String

    init(name: String) {
        self.name = name
    }
}

var student1 = StudentStruct(name: "Arun")
var student2 = student1

student2.name = "Bala"

print("Struct original: \(student1.name)")
print("Struct copy: \(student2.name)")

let person1 = StudentClass(name: "Arun")
let person2 = person1

person2.name = "Bala"

print("Class original: \(person1.name)")
print("Class copy: \(person2.name
